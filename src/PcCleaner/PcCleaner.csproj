<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PcCleaner</RootNamespace>
    <AssemblyName>WaterCa7sPcCleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Runs on any newer installed .NET desktop runtime (8, 9, ...) when 7 is absent. -->
    <RollForward>LatestMajor</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <Version>1.1.0</Version>
    <Product>WaterCa7s PC Cleaner</Product>
    <Company>WaterCa7</Company>
    <Copyright>© 2026 WaterCa7</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="7.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcCleaner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon (the exe icon comes from ApplicationIcon). -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- English UI texts ("Russian text": "English text"), read by Core/Localization/T.cs. -->
    <None Remove="Core\Localization\en.json" />
    <EmbeddedResource Include="Core\Localization\en.json" LogicalName="PcCleaner.Localization.en.json" />
  </ItemGroup>

</Project>
