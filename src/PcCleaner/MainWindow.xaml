<Window x:Class="PcCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PcCleaner"
        xmlns:loc="clr-namespace:PcCleaner.Core.Localization"
        Title="WaterCa7s PC Cleaner"
        Icon="/Assets/app.ico"
        Width="1320" Height="840" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- A big card of the first-run screen (Core/WelcomeViewModel): the whole card is the button. -->
        <Style x:Key="WelcomeCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="26,24" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RU / EN of the first-run screen: one of two, the language of this run is blue (Tag = is it this one). -->
        <Style x:Key="WelcomeLanguage" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A sidebar item: the icon and the title of a section (Core/SectionViewModel). -->
        <DataTemplate x:Key="SectionNavTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding IconGlyph}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <TextBlock Text="{Binding Title}" Margin="13,0,0,0" FontSize="13.5" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid x:Name="Root" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,22">
                        <!-- The app icon (a drop with cat ears): the AppLogo resource in Themes/Theme.xaml. -->
                        <Image Source="{StaticResource AppLogo}" Width="38" Height="38" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WaterCa7s" FontWeight="Bold" FontSize="15.5" />
                            <TextBlock Text="PC Cleaner" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="14,6,14,14" Style="{StaticResource InnerCard}" Padding="12,10">
                        <StackPanel>
                            <DockPanel ToolTipService.InitialShowDelay="300">
                                <DockPanel.ToolTip>
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                               Text="{loc:T 'Без прав администратора программа всё проверяет, но часть действий недоступна: системные папки, службы, раздел реестра HKLM, брандмауэр и другие настройки Windows.'}" />
                                </DockPanel.ToolTip>
                                <!-- Without admin rights is the normal mode, not an error: blue dot, green with admin rights. -->
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource InfoBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding AdminText}" Margin="8,0,6,0" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <Button Command="{Binding RestartAsAdminCommand}" Margin="0,8,0,0"
                                    Padding="10,5" FontSize="12" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{loc:T 'Перезапустить от имени администратора'}"
                                    ToolTip="{loc:T 'Перезапустить программу с правами администратора — откроется окно контроля учётных записей'}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock Text="{loc:T 'Перезапустить от имени администратора'}" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Профиль and Настройки: above the admin card (docked to the bottom after it, so it sits above). -->
                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding BottomSections}"
                             SelectedItem="{Binding SelectedBottomSection, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItem}" ItemTemplate="{StaticResource SectionNavTemplate}" />
                    <Border DockPanel.Dock="Bottom" Height="1" Margin="20,6" Background="{StaticResource LineBrush}" />

                    <!-- The sections of the current mode (a section is shown while it has a visible tab). -->
                    <ListBox ItemsSource="{Binding TopSections}" SelectedItem="{Binding SelectedTopSection, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItem}" ItemTemplate="{StaticResource SectionNavTemplate}" />
                </DockPanel>
            </Border>

            <!-- ===== Content ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="32,24,32,10">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding HeaderTitle}" />
                    <!-- The tabs of the section; a section with one visible tab has no strip. -->
                    <ListBox Margin="0,10,0,2" ItemsSource="{Binding SelectedSection.VisibleTabs}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource TabStripItem}"
                             Visibility="{Binding SelectedSection.ShowTabs, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Simple mode: one line, the whole text in the tooltip. -->
                    <TextBlock FontSize="13" Margin="0,4,0,0" Text="{Binding SelectedPage.Subtitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimpleMode}" Value="True">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding SelectedPage.Subtitle}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- The program runs under another account than the signed-in user (e.g. an administrator's password was
                         typed on a standard account): per-user checks then look at that account's profile. -->
                    <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="6" Background="{StaticResource WarningSoftBrush}"
                            Visibility="{Binding HasOtherAccountWarning, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Top" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding OtherAccountWarning}" TextWrapping="Wrap" FontSize="12.5" />
                        </DockPanel>
                    </Border>
                    <!-- Update strip: downloaded / installed / needs a manual download (Core/Updates/UpdateBanner). -->
                    <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6" Background="{StaticResource AccentSoftBrush}"
                            Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="8,5"
                                    Margin="6,0,0,0" ToolTip="{loc:T 'Скрыть'}" Command="{Binding DismissUpdateBannerCommand}" />
                            <Button DockPanel.Dock="Right" Content="{Binding UpdateBannerAction}" Padding="12,4" Margin="12,0,0,0"
                                    Command="{Binding UpdateBannerCommand}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding UpdateBannerText}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Shared busy strip for the current page -->
                <Border Grid.Row="1" Margin="32,0,32,8" Style="{StaticResource InnerCard}" Padding="12,8"
                        Visibility="{Binding SelectedPage.IsBusy, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPage.BusyText}" FontSize="12.5" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{Binding SelectedPage.Progress, Mode=OneWay}" Maximum="100"
                                         IsIndeterminate="{Binding SelectedPage.IsProgressIndeterminate, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:T 'Отмена'}" Margin="12,0,0,0" Padding="12,5"
                                Command="{Binding SelectedPage.CancelCommand}" />
                    </Grid>
                </Border>

                <ContentControl Grid.Row="2" Margin="32,4,32,16" Content="{Binding SelectedPage}" Focusable="False" />

                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,7">
                    <!-- The version and the state of the updater (Core/Updates/UpdateFooter). -->
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="11.5" Text="{Binding FooterText}" />
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Startup splash (Core/Updates/SplashViewModel) =====
             Over the blurred window while the program looks for a newer version. Collapsed by default, so screenshots and
             everything else never see it; MainWindow.xaml.cs shows it, blurs Root and fades both out. -->
        <Grid x:Name="SplashOverlay" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Grid.Background>
                <SolidColorBrush Color="{StaticResource BackgroundColor}" Opacity="0.35" />
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <Image Source="{StaticResource AppLogo}" Width="120" Height="120" />
                <TextBlock Text="WaterCa7s PC Cleaner" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Splash.StatusText}" FontSize="13" TextAlignment="Center"
                           Margin="0,8,0,0" />
                <!-- Fixed height: the logo and the texts stay put when the bar and «Пропустить» appear. -->
                <StackPanel Height="90" Margin="0,16,0,0">
                    <ProgressBar Maximum="1" Value="{Binding Splash.Progress, Mode=OneWay}" Margin="48,0"
                                 Visibility="{Binding Splash.ShowProgress, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{loc:T 'Пропустить'}" Command="{Binding Splash.SkipCommand}" HorizontalAlignment="Center" Margin="0,22,0,0"
                            Padding="20,7" ToolTip="{loc:T 'Открыть программу сразу; обновление установится при следующем запуске'}"
                            Visibility="{Binding Splash.CanSkip, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== Start screen: accounts (Modules/Profile/AccountIntroViewModel) =====
             After the splash, once per install: sign in, sign up or go on without an account. Then Welcome, if no mode is chosen. -->
        <Grid x:Name="AccountIntroOverlay" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle">
            <Grid.Background>
                <SolidColorBrush Color="{StaticResource BackgroundColor}" Opacity="0.45" />
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <Image Source="{StaticResource AppLogo}" Width="96" Height="96" />
                <TextBlock FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:T 'Аккаунт WaterCa7'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AccountIntro.IsUpdate}" Value="True">
                                    <Setter Property="Text" Value="{loc:T 'Появились аккаунты и Pro'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="{loc:T 'Войдите, чтобы включить Pro на этом компьютере, применить промокод и видеть свои компьютеры. Без входа программа работает бесплатно, как раньше.'}" />
                <Button Style="{StaticResource AccentButton}" Margin="0,28,0,0" Padding="18,10" HorizontalAlignment="Stretch"
                        Content="{loc:T 'Войти'}" Command="{Binding AccountIntro.SignInCommand}" />
                <Button Margin="0,10,0,0" Padding="18,10" HorizontalAlignment="Stretch"
                        Content="{loc:T 'Зарегистрироваться'}" Command="{Binding AccountIntro.RegisterCommand}" />
                <Button Style="{StaticResource LinkButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                        Content="{loc:T 'Продолжить без входа'}" Command="{Binding AccountIntro.SkipCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== First-run welcome (Core/WelcomeViewModel) =====
             After the splash, while no mode is chosen: the same blurred window, the logo, two cards and the RU / EN switch.
             Collapsed by default; MainWindow.xaml.cs shows it, blurs Root and fades both out. Esc does nothing: a choice is required.
             The cards come first in the Tab order, the language switch last. -->
        <Grid x:Name="WelcomeOverlay" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle">
            <Grid.Background>
                <SolidColorBrush Color="{StaticResource BackgroundColor}" Opacity="0.45" />
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="720">
                <Image Source="{StaticResource AppLogo}" Width="96" Height="96" />
                <TextBlock Text="{loc:T 'Добро пожаловать в WaterCa7s PC Cleaner'}" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
                <Grid Margin="0,34,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource WelcomeCard}" Command="{Binding Welcome.ChooseSimpleCommand}" Height="176">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="30" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{loc:T 'Простой'}" FontSize="21" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"
                                       Text="{loc:T 'Главное в одном месте: проверка, очистка и программы'}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource WelcomeCard}" Command="{Binding Welcome.ChooseExpertCommand}" Height="176">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="30" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{loc:T 'Опытный'}" FontSize="21" FontWeight="SemiBold" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"
                                       Text="{loc:T 'Все разделы, подробности и тонкие настройки'}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,22,0,0"
                           Text="{loc:T 'Режим можно изменить позже в «Настройках»'}" />
            </StackPanel>
            <!-- The names of the languages are written in their own language in both. -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,22,28,0">
                <Button Style="{StaticResource WelcomeLanguage}" Content="RU" Command="{Binding Welcome.ChooseRussianCommand}"
                        Tag="{Binding Welcome.IsRussian}" ToolTip="Русский" AutomationProperties.Name="Русский" Margin="0,0,8,0" />
                <Button Style="{StaticResource WelcomeLanguage}" Content="EN" Command="{Binding Welcome.ChooseEnglishCommand}"
                        Tag="{Binding Welcome.IsEnglish}" ToolTip="English" AutomationProperties.Name="English" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
