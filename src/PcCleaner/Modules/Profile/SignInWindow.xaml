<Window x:Class="PcCleaner.Modules.Profile.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PcCleaner.Modules.Profile"
        xmlns:loc="clr-namespace:PcCleaner.Core.Localization"
        Title="{loc:T 'Вход в аккаунт WaterCa7'}"
        Icon="/Assets/app.ico"
        Width="460" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- A label above a field. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>

        <!-- A tab of the strip: Tag = is it the chosen one. -->
        <Style x:Key="SignInTabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24">

                <!-- Tabs: on the first step of each tab only. -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="4"
                        Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SignInTabButton}" Content="{loc:T 'Почта и пароль'}"
                                Command="{Binding SelectTabCommand}" CommandParameter="{x:Static local:SignInTab.Password}"
                                Tag="{Binding IsPasswordTab}" />
                        <Button Grid.Column="1" Style="{StaticResource SignInTabButton}" Content="{loc:T 'Регистрация'}"
                                Command="{Binding SelectTabCommand}" CommandParameter="{x:Static local:SignInTab.Register}"
                                Tag="{Binding IsRegisterTab}" />
                        <Button Grid.Column="2" Style="{StaticResource SignInTabButton}" Content="{loc:T 'Через браузер'}"
                                Command="{Binding SelectTabCommand}" CommandParameter="{x:Static local:SignInTab.Browser}"
                                Tag="{Binding IsBrowserTab}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                           Visibility="{Binding Error, Converter={StaticResource HasValueToVis}}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Info}"
                           Visibility="{Binding Info, Converter={StaticResource HasValueToVis}}" />

                <!-- Password -->
                <StackPanel Visibility="{Binding IsPasswordStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Почта'}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Пароль'}" />
                    <PasswordBox x:Name="PasswordBox" />
                    <Button Style="{StaticResource AccentButton}" Margin="0,22,0,0" Padding="14,10" Content="{loc:T 'Войти'}"
                            Command="{Binding SignInCommand}" IsDefault="{Binding IsPasswordStep}" />
                    <Button Style="{StaticResource LinkButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Content="{loc:T 'Забыли пароль?'}" Command="{Binding ForgotCommand}" />
                </StackPanel>

                <!-- Reset: the e-mail -->
                <StackPanel Visibility="{Binding IsResetEmailStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Почта'}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource AccentButton}" Margin="0,22,0,0" Padding="14,10" Content="{loc:T 'Отправить код'}"
                            Command="{Binding SendResetCommand}" IsDefault="{Binding IsResetEmailStep}" />
                    <Button Margin="0,10,0,0" Content="{loc:T 'Назад'}" Command="{Binding BackCommand}" />
                </StackPanel>

                <!-- Reset: the code and the new password -->
                <StackPanel Visibility="{Binding IsResetCodeStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Код из письма'}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Новый пароль'}" />
                    <PasswordBox x:Name="NewPasswordBox" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Ещё раз'}" />
                    <PasswordBox x:Name="NewPasswordBox2" />
                    <Button Style="{StaticResource AccentButton}" Margin="0,22,0,0" Padding="14,10"
                            Content="{loc:T 'Сменить пароль и войти'}" Command="{Binding ConfirmResetCommand}"
                            IsDefault="{Binding IsResetCodeStep}" />
                    <Button Margin="0,10,0,0" Content="{Binding ResendText}" Command="{Binding ResendCommand}" />
                    <Button Margin="0,10,0,0" Content="{loc:T 'Назад'}" Command="{Binding BackCommand}" />
                </StackPanel>

                <!-- Sign-up -->
                <StackPanel Visibility="{Binding IsRegisterStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Почта'}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Пароль'}" />
                    <PasswordBox x:Name="RegisterPasswordBox" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0" Text="{loc:T 'Пароль — от 8 до 128 символов'}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T 'Ещё раз'}" />
                    <PasswordBox x:Name="RegisterPasswordBox2" />
                    <CheckBox Margin="0,18,0,0" IsChecked="{Binding Consent}" VerticalAlignment="Top">
                        <WrapPanel>
                            <TextBlock Text="{loc:T 'Принимаю'}" Margin="0,0,4,0" />
                            <Button Style="{StaticResource LinkButton}" Content="{loc:T 'оферту'}" Command="{Binding OpenOfferCommand}" />
                            <TextBlock Text="{loc:T 'и'}" Margin="4,0" />
                            <Button Style="{StaticResource LinkButton}" Content="{loc:T 'политику конфиденциальности'}"
                                    Command="{Binding OpenPrivacyCommand}" />
                        </WrapPanel>
                    </CheckBox>
                    <Button Style="{StaticResource AccentButton}" Margin="0,22,0,0" Padding="14,10"
                            Content="{loc:T 'Зарегистрироваться'}" Command="{Binding RegisterCommand}"
                            IsDefault="{Binding IsRegisterStep}" />
                </StackPanel>

                <!-- The code from the mail -->
                <StackPanel Visibility="{Binding IsVerifyStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource H3}" Margin="0,18,0,0" Text="{loc:T 'Введите код из письма'}" />
                    <TextBox Margin="0,14,0,0" FontSize="22" Padding="10,8" MaxLength="12"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource AccentButton}" Margin="0,22,0,0" Padding="14,10" Content="{loc:T 'Подтвердить'}"
                            Command="{Binding VerifyCommand}" IsDefault="{Binding IsVerifyStep}" />
                    <Button Margin="0,10,0,0" Content="{Binding ResendText}" Command="{Binding ResendCommand}" />
                    <Button Margin="0,10,0,0" Content="{loc:T 'Назад'}" Command="{Binding BackCommand}" />
                </StackPanel>

                <!-- Through the browser -->
                <StackPanel Visibility="{Binding IsBrowserStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,20,0,0"
                               Text="{loc:T 'Откроется сайт waterca7.ru. Войдите там и сверьте код с этим:'}" />
                    <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="12,20">
                        <TextBlock Text="{Binding BrowserCode}" FontFamily="Consolas" FontSize="34" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" TextAlignment="Center"
                               Text="{loc:T 'Ждём подтверждения на сайте… (до 10 минут)'}"
                               Visibility="{Binding BrowserEnded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <!-- Open again: only while the code is alive. New code: always there, the chosen button after the code ended. -->
                    <Button Margin="0,22,0,0" Content="{loc:T 'Открыть сайт ещё раз'}" Command="{Binding ReopenBrowserCommand}"
                            Visibility="{Binding BrowserEnded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <Button Style="{StaticResource AccentButton}" Margin="0,22,0,0" Padding="14,10" Content="{loc:T 'Новый код'}"
                            Command="{Binding RestartBrowserCommand}"
                            Visibility="{Binding BrowserEnded, Converter={StaticResource BoolToVis}}" />
                    <Button Margin="0,10,0,0" Content="{loc:T 'Новый код'}" Command="{Binding RestartBrowserCommand}"
                            Visibility="{Binding BrowserEnded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </StackPanel>

                <!-- DEVICE_LIMIT: the account's computers -->
                <StackPanel Visibility="{Binding IsDeviceLimitStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource H3}" Margin="0,18,0,0" Text="{loc:T 'Все компьютеры заняты'}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{Binding LimitText}" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="{Binding Details}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{loc:T 'Отвязать'}"
                                                Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="0,10,0,0" Content="{loc:T 'Назад'}" Command="{Binding BackCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
