<UserControl x:Class="PcCleaner.Modules.Disk.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PcCleaner.Modules.Disk"
             xmlns:loc="clr-namespace:PcCleaner.Core.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DiskViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">

    <UserControl.Resources>
        <local:ToneBrushConverter x:Key="ToneBrush" />
        <local:ActionStyleConverter x:Key="ActionStyle" />

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- Colored pill -->
        <DataTemplate x:Key="BadgeTemplate" DataType="{x:Type local:BadgeItem}">
            <Border Style="{StaticResource Badge}" Margin="0,4,6,0" ToolTip="{Binding ToolTip}"
                    Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Soft}">
                <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
            </Border>
        </DataTemplate>

        <!-- Rounded icon square -->
        <Style x:Key="IconBox" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Context menu of folder rows -->
        <ContextMenu x:Key="FolderMenu" x:Shared="False">
            <MenuItem Header="{loc:T 'Открыть папку в списке'}"
                      Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" />
            <MenuItem Header="{loc:T 'Показать в проводнике'}"
                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Копировать путь'}"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Что это за папка? (поиск в интернете)'}"
                      Command="{Binding PlacementTarget.Tag.SearchWebCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <!-- Context menu of the largest files -->
        <ContextMenu x:Key="FileMenu" x:Shared="False">
            <MenuItem Header="{loc:T 'Показать в проводнике'}"
                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Копировать путь'}"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Что это за файл? (поиск в интернете)'}"
                      Command="{Binding PlacementTarget.Tag.SearchWebCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Проверить на VirusTotal'}"
                      Command="{Binding PlacementTarget.Tag.VirusTotalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding IsExecutable, Converter={StaticResource BoolToVis}}" />
            <Separator />
            <MenuItem Header="{loc:T 'Удалить в корзину…'}"
                      Command="{Binding PlacementTarget.Tag.RecycleFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" Foreground="{StaticResource DangerBrush}" />
        </ContextMenu>

        <!-- Context menu of files inside suggestions -->
        <ContextMenu x:Key="SuggestionFileMenu" x:Shared="False">
            <MenuItem Header="{loc:T 'Показать в проводнике'}"
                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Копировать путь'}"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:T 'Что это за файл? (поиск в интернете)'}"
                      Command="{Binding PlacementTarget.Tag.SearchWebCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <Style x:Key="FolderRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FileRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="ContextMenu" Value="{StaticResource FileMenu}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

            <!-- ============================================================ Overview -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'Обзор'}" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Loading placeholder -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding ShowDrivesLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Загружаем сведения о дисках…'}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                <ProgressBar IsIndeterminate="True" />
                            </StackPanel>
                        </Border>

                        <!-- No drives found -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding ShowNoDrives, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20"
                                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Не удалось получить сведения о дисках'}" Style="{StaticResource H3}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="{loc:T 'Windows не сообщила ни об одном готовом локальном диске. Нажмите «Обновить» справа вверху, чтобы попробовать ещё раз.'}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Drive cards -->
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,-12,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.DriveColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DriveItem}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <!-- fills the extra height so the buttons line up at the bottom of every card -->
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource IconBox}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="19" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding SubTitle}" />
                                                    <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTemplate}"
                                                                  ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Free space -->
                                            <WrapPanel Grid.Row="1" Margin="0,14,0,6">
                                                <TextBlock Text="{Binding FreeText}" Style="{StaticResource BigNumber}" FontSize="26" />
                                                <TextBlock Text="{Binding TotalText}" Style="{StaticResource Muted}" FontSize="13" Margin="8,0,0,5"
                                                           VerticalAlignment="Bottom" />
                                            </WrapPanel>

                                            <ProgressBar Grid.Row="2" Height="8" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                                         Foreground="{Binding UsedPercent, Converter={StaticResource PercentToBrush}}" />

                                            <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" ToolTip="{Binding HealthToolTip}"
                                                        Background="{Binding HealthTone, Converter={StaticResource ToneBrush}, ConverterParameter=Soft}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" FontSize="12" Margin="0,0,5,0"
                                                                   Foreground="{Binding HealthTone, Converter={StaticResource ToneBrush}}" />
                                                        <TextBlock Text="{Binding HealthText}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding HealthTone, Converter={StaticResource ToneBrush}}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding UsedText}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </DockPanel>

                                            <!-- TRIM / low space -->
                                            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsLowSpace, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,0,4">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{StaticResource WarningBrush}"
                                                               Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding LowSpaceText}" Foreground="{StaticResource WarningBrush}" FontSize="12.5"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowTrim, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="{loc:T 'TRIM сообщает SSD об удалённых данных, чтобы накопитель не замедлялся со временем. Должен быть включён.'}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,6,0"
                                                               Foreground="{Binding TrimTone, Converter={StaticResource ToneBrush}}" />
                                                    <TextBlock Text="{Binding TrimText}" FontSize="12.5"
                                                               Foreground="{Binding TrimTone, Converter={StaticResource ToneBrush}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <WrapPanel Grid.Row="5" Margin="0,6,0,0">
                                                <Button Style="{StaticResource AccentButton}" Margin="0,6,8,0"
                                                        Command="{Binding DataContext.AnalyzeDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{loc:T 'Показать, какие папки и файлы занимают место на этом диске. Ничего не удаляется.'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="14" Margin="0,0,7,0" />
                                                        <TextBlock Text="{loc:T 'Что занимает место'}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="0,6,8,0" ToolTip="{Binding OptimizeToolTip}"
                                                        Command="{Binding DataContext.OptimizeDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="14" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding OptimizeText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Margin="0,6,0,0" Padding="10,7"
                                                        Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="{loc:T 'Открыть диск в проводнике'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,7,0" />
                                                        <TextBlock Text="{loc:T 'Открыть'}" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Suggestions teaser -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12"
                                Visibility="{Binding HasSuggestionsTeaser, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBox}" Width="36" Height="36" Background="{StaticResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="17" HorizontalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SuggestionsSummary}" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding SuggestionsTeaser}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SuggestionsTeaser}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:T 'Смотреть советы'}" VerticalAlignment="Center"
                                        Command="{Binding GoToSuggestionsCommand}" />
                            </Grid>
                        </Border>

                        <!-- TRIM disabled -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource WarningBrush}"
                                Visibility="{Binding ShowTrimWarning, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:T 'TRIM выключен'}" Style="{StaticResource H3}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,12,0"
                                               Text="{loc:T 'Без TRIM твердотельный накопитель со временем записывает всё медленнее и быстрее изнашивается. Обычно TRIM включён — возможно, его отключила какая-то программа-«оптимизатор».'}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="{loc:T 'Включить TRIM'}" VerticalAlignment="Center"
                                        Command="{Binding EnableTrimCommand}" ToolTip="{loc:T 'Нужны права администратора'}" />
                            </Grid>
                        </Border>

                        <!-- Physical disks -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding HasPhysicalDisks, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Физические накопители'}" Style="{StaticResource H3}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,6"
                                           Text="{loc:T 'Модель, тип и состояние каждого диска по данным Windows. Если накопитель сообщит о проблемах, программа предупредит вас.'}" />
                                <ItemsControl ItemsSource="{Binding PhysicalDisks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PhysicalDiskItem}">
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource IconBox}" Width="36" Height="36">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource InfoBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Margin="0,4,10,0"
                                                                       VerticalAlignment="Center" />
                                                            <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource BadgeTemplate}"
                                                                          ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                        <ItemsControl ItemsSource="{Binding Stats}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                                                      Margin="0,4,0,0" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type local:StatItem}">
                                                                    <Border Style="{StaticResource InnerCard}" Padding="10,5" Margin="0,4,8,0"
                                                                            ToolTip="{Binding ToolTip}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                                            <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"
                                                                   Visibility="{Binding ShowNoCounters, Converter={StaticResource BoolToVis}}"
                                                                   Text="{loc:T 'Накопитель не сообщает температуру и износ (так бывает с USB-дисками и некоторыми контроллерами).'}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Admin hint -->
                                <Border Style="{StaticResource InnerCard}" Background="{StaticResource InfoSoftBrush}" Margin="0,12,0,0" Padding="12,9"
                                        Visibility="{Binding ShowReliabilityAdminHint, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="15"
                                                   Foreground="{StaticResource InfoBrush}" Margin="0,0,10,0" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{loc:T 'Перезапустить от имени администратора'}"
                                                Command="{Binding RestartAsAdminCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                   Text="{loc:T 'Температура, износ и наработка накопителей видны при запуске программы от имени администратора.'}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="2,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="14"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="{loc:T 'Windows сама оптимизирует диски по расписанию раз в неделю: для SSD выполняет TRIM, для жёстких дисков — дефрагментацию. Запускать это вручную нужно редко.'}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Space analyzer -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'Что занимает место'}" />
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="520" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.01*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" MinWidth="200"
                                  ToolTip="{loc:T 'Что проанализировать: целый диск или одну из ваших папок'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LocationOption}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding PickFolderCommand}"
                                ToolTip="{loc:T 'Выбрать любую папку на компьютере и сразу проанализировать её'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:T 'Выбрать папку…'}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding AnalyzeCommand}"
                                ToolTip="{loc:T 'Посчитать размеры папок и найти самые большие файлы. Ничего не удаляется.'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:T 'Анализировать'}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Empty state -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                            Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" Margin="20,36" MaxWidth="560">
                            <Border Style="{StaticResource IconBox}" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{loc:T 'Узнайте, что занимает место'}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" FontSize="13"
                                       Text="{loc:T 'Выберите диск или папку и нажмите «Анализировать». Программа посчитает размер каждой папки, найдёт самые большие файлы и покажет, сколько места занимают видео, игры, архивы и другие типы файлов.'}" />
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0"
                                       Text="{loc:T 'Анализ только читает диск и ничего не удаляет. Целый диск на 1–2 ТБ проверяется за пару минут.'}" />
                            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="20,9"
                                    Command="{Binding AnalyzeCommand}" Content="{loc:T 'Анализировать'}" />
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                            Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>

                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,9,0" />
                                <TextBlock Text="{Binding AnalyzedPath}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding AnalyzedPath}" />
                            </DockPanel>
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Text="{Binding AnalysisSummary}" Style="{StaticResource Muted}" Margin="0,4,12,0" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding AnalysisNotes}" ItemTemplate="{StaticResource BadgeTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Folders + types -->
                    <Grid Grid.Row="2" Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" MinWidth="380" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <!-- Breadcrumb -->
                                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="6,4" Margin="0,0,6,0"
                                            Command="{Binding UpCommand}" ToolTip="{loc:T 'На уровень вверх (Backspace)'}" VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="13" />
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentFolderSize}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                                  VerticalAlignment="Center" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:BreadcrumbItem}">
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Name}"
                                                            Command="{Binding DataContext.BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="6,0"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>

                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0"
                                           Text="{loc:T 'Двойной щелчок — открыть папку · правая кнопка мыши — другие действия'}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                <Grid>
                                    <DataGrid x:Name="FoldersGrid" ItemsSource="{Binding FolderRows}" RowStyle="{StaticResource FolderRowStyle}"
                                              SelectionMode="Single" CanUserSortColumns="False" CanUserReorderColumns="False"
                                              MouseDoubleClick="FoldersGrid_MouseDoubleClick" PreviewKeyDown="FoldersGrid_PreviewKeyDown">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{loc:T 'Папка'}" Width="*" MinWidth="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type local:FolderRow}">
                                                        <DockPanel Background="Transparent" ToolTip="{Binding ToolTip}">
                                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15"
                                                                       Margin="0,0,9,0"
                                                                       Foreground="{Binding IconTone, Converter={StaticResource ToneBrush}}" />
                                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{loc:T 'ссылка'}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                            </Border>
                                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                                    Background="{StaticResource WarningSoftBrush}"
                                                                    Visibility="{Binding IsInaccessible, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{loc:T 'нет доступа'}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{loc:T 'Размер'}" Binding="{Binding SizeText}" Width="84"
                                                                ElementStyle="{StaticResource RightText}" />
                                            <DataGridTemplateColumn Header="{loc:T 'Доля'}" Width="118">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type local:FolderRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="44" />
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Maximum="100" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"
                                                                         Foreground="{StaticResource InfoBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource MutedCell}"
                                                                       HorizontalAlignment="Right" FontSize="12" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{loc:T 'Файлов'}" Binding="{Binding FilesText}" Width="78"
                                                                ElementStyle="{StaticResource RightText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{loc:T 'Эта папка пуста.'}" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding FolderRows.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=Invert}" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Types -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="{loc:T 'По типам файлов'}" Style="{StaticResource H3}" />
                                    <TextBlock Text="{loc:T 'Для всей проанализированной папки'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:CategoryRow}">
                                                <Grid Margin="0,8,4,2" Background="Transparent" ToolTip="{Binding Description}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.RowSpan="2" Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15"
                                                               Foreground="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Maximum="100" Margin="0,5,0,0" Height="5"
                                                                 Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Muted}" FontSize="11.5"
                                                               Margin="0,3,0,0">
                                                        <Run Text="{Binding CountText, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding PercentText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ Largest files -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'Большие файлы'}" />
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Empty state -->
                    <Border Grid.RowSpan="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                            Visibility="{Binding HasLargestFiles, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" Margin="20,36" MaxWidth="520">
                            <Border Style="{StaticResource IconBox}" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{StaticResource InfoSoftBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{StaticResource InfoBrush}" />
                            </Border>
                            <TextBlock Text="{loc:T 'Здесь появятся самые большие файлы'}" Style="{StaticResource H2}" HorizontalAlignment="Center"
                                       Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" FontSize="13"
                                       Text="{loc:T 'Сначала проанализируйте диск или папку на вкладке «Что занимает место» — программа найдёт 100 самых больших файлов, и ненужные можно будет отправить в корзину.'}" />
                            <Button HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,8" Content="{loc:T 'Перейти к анализу'}"
                                    Command="{Binding GoToAnalyzerCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Header -->
                    <Grid Margin="0,0,0,12" Visibility="{Binding HasLargestFiles, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LargestFilesTitle}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LargestFilesTitle}" />
                            <TextBlock Text="{Binding SelectedFilesText}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Снять отметки'}" Command="{Binding ClearSelectionCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding RecycleCheckedFilesCommand}"
                                    ToolTip="{loc:T 'Переместить отмеченные файлы в корзину. Их можно будет восстановить.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T 'Удалить в корзину'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"
                            Visibility="{Binding HasLargestFiles, Converter={StaticResource BoolToVis}}">
                        <DataGrid x:Name="FilesGrid" ItemsSource="{Binding LargestFiles}" RowStyle="{StaticResource FileRowStyle}"
                                  CanUserReorderColumns="False" MouseDoubleClick="FilesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type local:LargeFileRow}">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"
                                                      ToolTip="{loc:T 'Отметить для удаления в корзину'}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:T 'Файл'}" Width="1.4*" MinWidth="140" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type local:LargeFileRow}">
                                            <DockPanel Background="Transparent" ToolTip="{Binding ToolTip}">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15"
                                                           Foreground="{Binding Brush}" Margin="0,0,9,0" />
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"
                                                           Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12"
                                                           Foreground="{StaticResource WarningBrush}" Margin="6,0,0,0"
                                                           Visibility="{Binding RiskNote, Converter={StaticResource HasValueToVis}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:T 'Папка'}" Binding="{Binding Folder}" Width="1.6*" MinWidth="120"
                                                    ElementStyle="{StaticResource MutedCell}" />
                                <DataGridTextColumn Header="{loc:T 'Тип'}" Binding="{Binding CategoryName}" Width="118"
                                                    ElementStyle="{StaticResource MutedCell}" />
                                <DataGridTextColumn Header="{loc:T 'Размер'}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="86"
                                                    ElementStyle="{StaticResource RightText}" />
                                <DataGridTextColumn Header="{loc:T 'Изменён'}" Binding="{Binding ModifiedText}" SortMemberPath="Hit.ModifiedUtc" Width="92"
                                                    ElementStyle="{StaticResource MutedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ Suggestions -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'Советы по месту'}" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Summary -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBox}" Width="44" Height="44" Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="20" HorizontalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SuggestionsSummary}" Style="{StaticResource H2}" Margin="0" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="{loc:T 'Ничего не удаляется без вашего подтверждения: файлы отправляются в корзину, а системные настройки меняются только после вопроса.'}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Loading -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="{Binding IsSuggestionsLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Ищем, что можно освободить: старые загрузки, большие видео, системные файлы…'}" Style="{StaticResource Muted}"
                                           Margin="0,0,0,8" />
                                <ProgressBar IsIndeterminate="True" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SuggestionItem}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource IconBox}"
                                                    Background="{Binding Tone, Converter={StaticResource ToneBrush}, ConverterParameter=Soft}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center"
                                                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" FontStyle="Italic" Margin="0,4,0,0"
                                                           Visibility="{Binding Note, Converter={StaticResource HasValueToVis}}" />

                                                <!-- Actions -->
                                                <WrapPanel Margin="0,4,0,0">
                                                    <Button Style="{StaticResource GhostButton}" Margin="0,6,8,0" Padding="10,6"
                                                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="13" Margin="0,0,7,0" />
                                                            <TextBlock Text="{Binding ExpandText}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <ItemsControl ItemsSource="{Binding Actions}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:SuggestionAction}">
                                                                <Button Content="{Binding Text}" Command="{Binding Command}" CommandParameter="{Binding Parameter}"
                                                                        ToolTip="{Binding ToolTip}" Margin="0,6,8,0"
                                                                        Style="{Binding Converter={StaticResource ActionStyle}}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>

                                                <!-- Files -->
                                                <Border Style="{StaticResource InnerCard}" Margin="0,12,0,0" Padding="10,8"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <DockPanel Margin="2,0,2,6">
                                                            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="{loc:T 'Отметить все / снять'}"
                                                                    Command="{Binding DataContext.CheckAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                                        </DockPanel>
                                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:SuggestionFile}">
                                                                        <Grid Margin="0,3" Background="Transparent" ToolTip="{Binding Path}"
                                                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              ContextMenu="{StaticResource SuggestionFileMenu}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                                                                               TextTrimming="CharacterEllipsis">
                                                                                        <Run Text="{Binding Note, Mode=OneWay}" />
                                                                                        <Run Text=" · " />
                                                                                        <Run Text="{Binding Folder, Mode=OneWay}" />
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </CheckBox>
                                                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="12,0,4,0"
                                                                                       VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SizeText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"
                                                           Visibility="{Binding SizeText, Converter={StaticResource HasValueToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Refresh (top right, next to the tabs) -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Margin="0,2,0,0"
                Command="{Binding RefreshCommand}" ToolTip="{loc:T 'Заново получить сведения о дисках и советы по месту'}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,7,0" />
                <TextBlock Text="{loc:T 'Обновить'}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
