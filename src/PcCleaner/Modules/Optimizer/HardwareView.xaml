<UserControl x:Class="PcCleaner.Modules.Optimizer.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PcCleaner.Modules.Optimizer"
             xmlns:loc="clr-namespace:PcCleaner.Core.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:HardwareViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">
    <UserControl.Resources>
        <local:ToneToBrushConverter x:Key="ToneBrush" />
        <local:ToneToSoftBrushConverter x:Key="ToneSoft" />
        <local:BalancedColumnsConverter x:Key="BalancedColumns" />

        <!-- Small coloured pill bound to a Tone -->
        <Style x:Key="ToneBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Hardware card: focusable, so keyboard users get the same details as mouse users
             (Tab shows the tooltip, Shift+F10 or the Menu key opens the context menu). -->
        <Style x:Key="HardwareCardStyle" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Hardware card ===== -->
        <DataTemplate x:Key="HardwareCardTemplate" DataType="{x:Type local:HardwareCard}">
            <Border Style="{StaticResource HardwareCardStyle}" Margin="0,0,12,12" Padding="14,13" Background="{StaticResource SurfaceBrush}"
                    ToolTipService.IsEnabled="{Binding HasToolTip}" ToolTipService.ShowDuration="20000">
                <Border.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{Binding ToolTipText}" />
                    </ToolTip>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T 'Скопировать'}" Command="{Binding CopyCommand}" />
                        <MenuItem Header="{loc:T 'Найти в интернете'}" Command="{Binding SearchCommand}"
                                  Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,10,0,0"
                               TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding Primary}" FontSize="13" Margin="0,3,0,0" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Details}" Margin="0,5,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Row="4" Style="{StaticResource LinkButton}" Margin="0,8,0,0" FontSize="12.5"
                            HorizontalAlignment="Left" Content="{Binding ActionText}" ToolTip="{Binding ActionToolTip}"
                            Command="{Binding DataContext.CardActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                    <Border Grid.Row="5" Style="{StaticResource Badge}" Margin="0,9,0,0"
                            Background="{Binding BadgeTone, Converter={StaticResource ToneSoft}}"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource ToneBadgeText}"
                                   Foreground="{Binding BadgeTone, Converter={StaticResource ToneBrush}}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <!-- The optimizer's state: the bindings below are the ones of OptimizerView. -->
        <StackPanel Margin="0,0,10,8" DataContext="{Binding Optimizer}">

            <!-- ===== Loading placeholder ===== -->
            <Border Style="{StaticResource Card}" Padding="22,20"
                    Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="22" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H3}" Text="{loc:T 'Изучаем ваш компьютер…'}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="{loc:T 'Собираем сведения о процессоре, памяти, видеокарте, мониторах и настройках Windows. Ничего не меняем — только смотрим.'}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== First load cancelled / failed ===== -->
            <Border Style="{StaticResource Card}" Padding="22,20"
                    Visibility="{Binding ShowLoadError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H3}" Text="{loc:T 'Сведения о компьютере не собраны'}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding LoadError}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Padding="16,8" VerticalAlignment="Center"
                            Command="{Binding RetryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                            <TextBlock Text="{loc:T 'Повторить'}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Result banner (card actions, e.g. the battery report, report here; same as on OptimizerView) ===== -->
            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10" Padding="14,10" BorderThickness="1"
                    BorderBrush="{Binding BannerTone, Converter={StaticResource ToneBrush}}"
                    Background="{Binding BannerTone, Converter={StaticResource ToneSoft}}"
                    Visibility="{Binding Banner, Converter={StaticResource HasValueToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" VerticalAlignment="Top" Margin="0,1,0,0"
                               Foreground="{Binding BannerTone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Banner}" TextWrapping="Wrap" Margin="10,0,10,0" FontSize="13" LineHeight="19" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6,3" VerticalAlignment="Top"
                            Command="{Binding DismissBannerCommand}" ToolTip="{loc:T 'Скрыть'}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <DockPanel Margin="0,4,0,10" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Right" Padding="12,5" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                        Content="{loc:T 'Обновить'}" />
                <TextBlock Style="{StaticResource H2}" Text="{loc:T 'Ваш компьютер'}" Margin="0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Margin="12,3,12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{loc:T 'Наведите на карточку, чтобы увидеть подробности; правый клик — скопировать или найти в интернете.'}" />
            </DockPanel>

            <ItemsControl x:Name="HardwareGrid" ItemsSource="{Binding HardwareCards}" Margin="0,0,-12,0" Focusable="False"
                          ItemTemplate="{StaticResource HardwareCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Balanced: 8 cards = 4 × 2, 9 cards (laptop with battery) = 3 × 3, never a lonely last card -->
                        <UniformGrid>
                            <UniformGrid.Columns>
                                <MultiBinding Converter="{StaticResource BalancedColumns}" ConverterParameter="225">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    <Binding Path="HardwareCards.Count" />
                                </MultiBinding>
                            </UniformGrid.Columns>
                        </UniformGrid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
