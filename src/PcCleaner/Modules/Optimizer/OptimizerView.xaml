<UserControl x:Class="PcCleaner.Modules.Optimizer.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PcCleaner.Modules.Optimizer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:OptimizerViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">
    <UserControl.Resources>
        <local:ToneToBrushConverter x:Key="ToneBrush" />
        <local:ToneToSoftBrushConverter x:Key="ToneSoft" />
        <local:ColumnsForWidthConverter x:Key="Columns" />

        <!-- Small coloured pill bound to a Tone -->
        <Style x:Key="ToneBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ===== Hardware card ===== -->
        <DataTemplate x:Key="HardwareCardTemplate" DataType="{x:Type local:HardwareCard}">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,13" Background="{StaticResource SurfaceBrush}"
                    ToolTipService.IsEnabled="{Binding HasToolTip}" ToolTipService.ShowDuration="20000">
                <Border.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{Binding ToolTipText}" />
                    </ToolTip>
                </Border.ToolTip>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Скопировать" Command="{Binding CopyCommand}" />
                        <MenuItem Header="Найти в интернете" Command="{Binding SearchCommand}"
                                  Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,10,0,0"
                               TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding Primary}" FontSize="13" Margin="0,3,0,0" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Details}" Margin="0,5,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="4" Style="{StaticResource Badge}" Margin="0,9,0,0"
                            Background="{Binding BadgeTone, Converter={StaticResource ToneSoft}}"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource ToneBadgeText}"
                                   Foreground="{Binding BadgeTone, Converter={StaticResource ToneBrush}}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Recommendation card ===== -->
        <DataTemplate x:Key="RecommendationTemplate" DataType="{x:Type local:Recommendation}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Скопировать текст рекомендации"
                                  Command="{Binding PlacementTarget.Tag.CopyRecommendationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </Border.Tag>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="9" VerticalAlignment="Top"
                            Background="{Binding ImpactTone, Converter={StaticResource ToneSoft}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding CategoryIcon}" FontSize="17" HorizontalAlignment="Center"
                                   Foreground="{Binding ImpactTone, Converter={StaticResource ToneBrush}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="14.5" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4"
                                    Background="{Binding ImpactTone, Converter={StaticResource ToneSoft}}">
                                <TextBlock Text="{Binding ImpactText}" Style="{StaticResource ToneBadgeText}"
                                           Foreground="{Binding ImpactTone, Converter={StaticResource ToneBrush}}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4">
                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource ToneBadgeText}" FontWeight="Normal"
                                           Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{StaticResource AccentSoftBrush}"
                                    Visibility="{Binding IsAutoFix, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Программа может изменить эту настройку сама и запомнит прежнее значение, чтобы его можно было вернуть.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="В один клик" Style="{StaticResource ToneBadgeText}" Margin="4,0,0,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{StaticResource WarningSoftBrush}"
                                    Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Эта настройка общая для всех пользователей компьютера, поэтому Windows разрешает менять её только администратору.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="Нужны права администратора" Style="{StaticResource ToneBadgeText}" Margin="4,0,0,0"
                                               Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{StaticResource InfoSoftBrush}"
                                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="11" Foreground="{StaticResource InfoBrush}" />
                                    <TextBlock Text="Нужна перезагрузка" Style="{StaticResource ToneBadgeText}" Margin="4,0,0,0"
                                               Foreground="{StaticResource InfoBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                                   LineHeight="19" />
                        <TextBlock Margin="0,7,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Visibility="{Binding HasCurrentValue, Converter={StaticResource BoolToVis}}">
                            <Run Text="Сейчас: " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding CurrentValue, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}" Margin="0,0,8,6" Padding="14,6"
                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding ShowApply, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Покажет, что именно изменится, и попросит подтверждение">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                                    <TextBlock Text="Применить" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Padding="12,6"
                                    Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Вернуть значение, которое было до изменения программой">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="13" />
                                    <TextBlock Text="Вернуть" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Padding="12,6"
                                    Command="{Binding DataContext.ToggleStepsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
                                    <TextBlock Text="Как сделать" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Padding="12,6"
                                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="13" />
                                    <TextBlock Text="{Binding SettingsLabel}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Padding="12,6"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding HasNavigate, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" />
                                    <TextBlock Text="{Binding NavigateLabel}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Style="{StaticResource InnerCard}" Margin="0,4,0,0" Padding="14,12"
                                Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding StepItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                                                    Background="{StaticResource Surface3Brush}">
                                                <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="10,2,0,0"
                                                       FontSize="13" LineHeight="19" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Passed check ===== -->
        <DataTemplate x:Key="PassedTemplate" DataType="{x:Type local:Recommendation}">
            <Border Style="{StaticResource InnerCard}" Margin="0,0,10,10" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0"
                               Foreground="{StaticResource SuccessBrush}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentValue}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding HasCurrentValue, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Margin="8,0,0,0" Padding="10,4" FontSize="12" VerticalAlignment="Center"
                            Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                            ToolTip="Эту настройку изменила программа. Нажмите, чтобы вернуть прежнее значение.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="12" />
                            <TextBlock Text="Вернуть" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,10,8">

            <!-- ===== Loading placeholder ===== -->
            <Border Style="{StaticResource Card}" Padding="22,20"
                    Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="22" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H3}" Text="Изучаем ваш компьютер…" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="Собираем сведения о процессоре, памяти, видеокарте, мониторах и настройках Windows. Ничего не меняем — только смотрим." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== First load cancelled / failed ===== -->
            <Border Style="{StaticResource Card}" Padding="22,20"
                    Visibility="{Binding ShowLoadError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource WarningSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H3}" Text="Сведения о компьютере не собраны" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding LoadError}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Padding="16,8" VerticalAlignment="Center"
                            Command="{Binding RetryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                            <TextBlock Text="Повторить" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Summary ===== -->
            <Border Style="{StaticResource Card}" Padding="20,18"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource H2}" FontSize="17" Margin="0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,8,0,0" Focusable="False"
                                      Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SummaryChip}">
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Background="{Binding Tone, Converter={StaticResource ToneSoft}}">
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource ToneBadgeText}"
                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyAllCommand}" Padding="16,8"
                                ToolTip="{Binding ApplyAllToolTip}"
                                Visibility="{Binding HasSafeFixes, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Foreground="{StaticResource AccentTextBrush}" />
                                <TextBlock Text="{Binding ApplyAllText}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Command="{Binding CopyReportCommand}"
                                    ToolTip="Скопировать сведения о компьютере и рекомендации — удобно для форума или поддержки">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" />
                                    <TextBlock Text="Скопировать" Margin="6,0,0,0" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="4,0,0,0"
                                    ToolTip="Заново собрать сведения о железе и настройках">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Обновить" Margin="6,0,0,0" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Result banner ===== -->
            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Padding="14,10" BorderThickness="1"
                    BorderBrush="{Binding BannerTone, Converter={StaticResource ToneBrush}}"
                    Background="{Binding BannerTone, Converter={StaticResource ToneSoft}}"
                    Visibility="{Binding Banner, Converter={StaticResource HasValueToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" VerticalAlignment="Top" Margin="0,1,0,0"
                               Foreground="{Binding BannerTone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Banner}" TextWrapping="Wrap" Margin="10,0,10,0" FontSize="13" LineHeight="19" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6,3" VerticalAlignment="Top"
                            Command="{Binding DismissBannerCommand}" ToolTip="Скрыть">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Admin hint ===== -->
            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0" Padding="14,10"
                    Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="10,0,12,0" VerticalAlignment="Center"
                               Text="Программа работает без прав администратора. Анализ выполнен полностью, но настройки с пометкой «Нужны права администратора» можно применить только после перезапуска от имени администратора." />
                    <Button Grid.Column="2" Content="Перезапустить" Padding="12,5" Command="{Binding RestartAsAdminCommand}"
                            ToolTip="Перезапустить программу от имени администратора" />
                </Grid>
            </Border>

            <!-- ===== Hardware ===== -->
            <DockPanel Margin="0,22,0,10" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource H2}" Text="Ваш компьютер" Margin="0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Margin="12,3,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" Text="Наведите на карточку, чтобы увидеть подробности; правый клик — скопировать или найти в интернете." />
            </DockPanel>
            <ItemsControl x:Name="HardwareGrid" ItemsSource="{Binding HardwareCards}" Margin="0,0,-12,0" Focusable="False"
                          ItemTemplate="{StaticResource HardwareCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Columns}, ConverterParameter=225}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ===== Recommendations ===== -->
            <StackPanel Visibility="{Binding HasRecommendations, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource H2}" Text="Рекомендации" Margin="0,14,0,2" />
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RecommendationGroup}">
                            <StackPanel Margin="0,8,0,0">
                                <DockPanel Margin="2,0,0,8">
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource H3}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="8,0,0,0" Padding="7,1">
                                        <TextBlock Text="{Binding Count}" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RecommendationTemplate}"
                                              Focusable="False" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Nothing to do ===== -->
            <Border Margin="0,14,0,0" Padding="20,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasData}" Value="True" />
                                    <Condition Binding="{Binding HasRecommendations}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE930;" FontSize="26" Foreground="{StaticResource SuccessBrush}" />
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource H3}" Text="Компьютер уже настроен на скорость" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="Мы не нашли, что можно улучшить в железе и настройках Windows. Загляните в «Автозагрузку» и «Очистку» — там тоже бывает что ускорить." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Already fine ===== -->
            <StackPanel Visibility="{Binding HasPassed, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,18,0,10">
                    <TextBlock Style="{StaticResource H2}" Text="Уже в порядке" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" Margin="12,3,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Text="Эти проверки пройдены — здесь же можно вернуть настройки, изменённые программой." />
                </DockPanel>
                <ItemsControl x:Name="PassedGrid" ItemsSource="{Binding Passed}" ItemTemplate="{StaticResource PassedTemplate}"
                              Margin="0,0,-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Columns}, ConverterParameter=330}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- ===== More to check ===== -->
            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource H2}" Text="Что ещё ускорит компьютер" Margin="0,14,0,10" />
                <ItemsControl x:Name="LinksGrid" ItemsSource="{Binding Links}" Margin="0,0,-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Columns}, ConverterParameter=330}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Recommendation}">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NavigateLabel}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
