<UserControl x:Class="PcCleaner.Modules.Optimizer.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PcCleaner.Modules.Optimizer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:OptimizerViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">
    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <TextBlock Style="{StaticResource Muted}" Text="Раздел в разработке" />
    </Border>
</UserControl>
