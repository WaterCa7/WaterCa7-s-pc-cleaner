<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RollForward>LatestMajor</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RootNamespace>PcCleaner.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.3" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcCleaner\PcCleaner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public update-signing key; EmbeddedKey_IsTheOneInTools compares it with UpdateKeys. -->
    <EmbeddedResource Include="..\..\tools\update-signing-public.pem" LogicalName="update-signing-public.pem" />
    <!-- The server's TEST license key (public half): LicenseKeys must never contain it. -->
    <EmbeddedResource Include="Account\Fixtures\license_test_pub.pem" LogicalName="license_test_pub.pem" />
    <!-- A copy of the site's app/data/features.php: Features must list the same keys (update both when the site's table changes). -->
    <EmbeddedResource Include="Account\Fixtures\features.php" LogicalName="features.php" />
  </ItemGroup>

</Project>
